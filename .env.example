# =====================================================
# 用户信息管理平台 - 环境变量配置文件
# cp .env.example .env 并按需修改
# =====================================================
USERMGR_SECRET_KEY=***
USERMGR_DEBUG=false
USERMGR_HOST=127.0.0.1
USERMGR_PORT=5000
FLASK_ENV=production
USERMGR_TLS_ENABLED=false
USERMGR_TLS_CERT_PATH=
USERMGR_TLS_KEY_PATH=
USERMGR_SESSION_COOKIE_SECURE=true
USERMGR_PASSWORD_MIN_LENGTH=8
USERMGR_PASSWORD_REQUIRE_UPPERCASE=true
USERMGR_PASSWORD_REQUIRE_LOWERCASE=true
USERMGR_PASSWORD_REQUIRE_DIGIT=true
USERMGR_PASSWORD_REQUIRE_SPECIAL=true
USERMGR_BCRYPT_ROUNDS=12
USERMGR_RATELIMIT_ENABLED=true
USERMGR_RATELIMIT_LOGIN_MAX=5
USERMGR_RATELIMIT_LOGIN_WINDOW=300
USERMGR_LOG_LEVEL=INFO
